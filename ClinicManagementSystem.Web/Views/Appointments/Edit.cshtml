@using ClinicManagementSystem.Web.Services
@model ClinicManagementSystem.Web.Models.ViewModels.Appointments.AppointmentFormViewModel
@{ ViewData["Title"] = Model.Exists ? "Lịch tái khám của hóa đơn" : "Đặt hẹn tái khám"; }
<h2>@ViewData["Title"]</h2>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<div class="card mb-3"><div class="card-body">
    <strong>@Model.PatientName</strong> · @Model.PatientCode · @(Model.PhoneNumber ?? "Chưa có số điện thoại")
    <div>Hóa đơn <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SaleId">@Model.SaleCode</a></div>
    @if (Model.Exists)
    {
        <p class="mb-0 mt-2">Trạng thái: <strong>@(Model.Status switch { "Attended" => "Đã đến", "Cancelled" => "Đã hủy", _ => "Chờ tái khám" })</strong></p>
    }
</div></div>
<form asp-action="Edit" method="post" id="appointment-form" class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <input asp-for="SaleId" type="hidden" />
        <input asp-for="Version" type="hidden" />
        <fieldset disabled="@(Model.Exists && Model.Status != "Pending")">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MedicationDays" class="form-label"></label>
                    <input asp-for="MedicationDays" type="number" min="1" max="3650" step="1" class="form-control" />
                    <span asp-validation-for="MedicationDays" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MedicationStartDate" class="form-label"></label>
                    <input asp-for="MedicationStartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="MedicationStartDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AppointmentDate" class="form-label"></label>
                    <input asp-for="AppointmentDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-text mt-2" id="appointment-date-hint" aria-live="polite">Ngày tái khám tự động = ngày bắt đầu uống thuốc + số ngày thuốc.</div>
            <div class="form-check my-3">
                <input asp-for="UseCustomDate" class="form-check-input" />
                <label asp-for="UseCustomDate" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            @if (!Model.Exists || Model.Status == "Pending")
            {
                <button type="submit" class="btn btn-primary">@(Model.Exists ? "Lưu thay đổi lịch hẹn" : "Đặt hẹn tái khám")</button>
            }
        </fieldset>
        @if (Model.Exists && Model.Status != "Pending")
        {
            <p class="text-muted">Lịch đã xử lý được giữ lại để tra cứu và không thể sửa.</p>
        }
        <div class="mt-3 d-flex flex-wrap gap-2">
            <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SaleId" class="btn btn-outline-secondary">Về hóa đơn</a>
            <a asp-action="Index" asp-route-fromDate="@Model.AppointmentDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.AppointmentDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Xem lịch ngày này</a>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-form.js" asp-append-version="true"></script>
}
