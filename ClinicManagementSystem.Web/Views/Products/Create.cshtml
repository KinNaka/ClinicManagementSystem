@model ClinicManagementSystem.Web.Models.ViewModels.Products.ProductFormViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-4">
    <h2>Create Product</h2>
    <p class="text-muted">Add a medicine or medical supply.</p>
    <hr />

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ProductCode" class="form-label"></label>
                <input asp-for="ProductCode" class="form-control" />
                <span asp-validation-for="ProductCode" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId"
                        asp-items="Model.Categories"
                        class="form-select">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Unit" class="form-label"></label>
                <input asp-for="Unit" class="form-control" placeholder="Box, bottle, tablet..." />
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Strength" class="form-label"></label>
                <input asp-for="Strength" class="form-control" placeholder="500 mg..." />
                <span asp-validation-for="Strength" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="DosageForm" class="form-label"></label>
                <input asp-for="DosageForm" class="form-control" placeholder="Tablet, capsule, solution..." />
                <span asp-validation-for="DosageForm" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Manufacturer" class="form-label"></label>
                <input asp-for="Manufacturer" class="form-control" />
                <span asp-validation-for="Manufacturer" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="CostPrice" class="form-label"></label>
                <input asp-for="CostPrice" type="number" min="0" step="0.01" class="form-control" />
                <span asp-validation-for="CostPrice" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="SellingPrice" class="form-label"></label>
                <input asp-for="SellingPrice" type="number" min="0" step="0.01" class="form-control" />
                <span asp-validation-for="SellingPrice" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="MinimumStock" class="form-label"></label>
                <input asp-for="MinimumStock" type="number" min="0" step="0.01" class="form-control" />
                <span asp-validation-for="MinimumStock" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="CurrentStock" class="form-label"></label>
                <input asp-for="CurrentStock" type="number" min="0" step="0.001" class="form-control" />
                <span asp-validation-for="CurrentStock" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="ACTIVE">ACTIVE</option>
                    <option value="INACTIVE">INACTIVE</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <partial name="_ComboForm" model="Model" />
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Create Product</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
<script src="~/js/search-picker.js" asp-append-version="true"></script><script src="~/js/combo-form.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
