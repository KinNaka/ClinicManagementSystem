@model ClinicManagementSystem.Web.Models.ViewModels.Account.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<h2 class="mb-3">Đổi mật khẩu Admin</h2>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<form asp-action="ChangePassword" method="post" style="max-width:520px">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /></div>
    <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" maxlength="128" /></div>
    <p class="text-muted small">Mật khẩu mới tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</p>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" maxlength="128" /></div>
    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
    <a asp-controller="UserManagement" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
