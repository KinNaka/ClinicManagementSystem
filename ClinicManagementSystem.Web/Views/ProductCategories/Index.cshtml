@model List<ClinicManagementSystem.Web.Models.ViewModels.ProductCategories.ProductCategoryListViewModel>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh mục sản phẩm</h2>

        @if (User.IsInRole("Admin"))
        {
        <a asp-action="Create" class="btn btn-primary">
            + Thêm danh mục
        </a>
        }
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Mã danh mục</th>
                <th>Tên danh mục</th>
                <th>Trạng thái</th>
                <th style="width: 180px;">Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@(item.Status is "ACTIVE" or "Active" ? "Đang hoạt động" : "Ngừng hoạt động")</td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Sửa
                            </a>
                            <form asp-action="ToggleStatus"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-secondary">
                                    @(item.Status == "ACTIVE" ? "Ngừng hoạt động" : "Kích hoạt")
                                </button>

                            </form>
                            @* <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Bạn có muốn xóa danh mục này?');">
                                    Xóa
                                </button>

                            </form> *@

                            }
                            </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        Chưa có danh mục sản phẩm.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<partial name="_ListPaging" model="@((ClinicManagementSystem.Web.Services.ListPaging?)ViewData["Paging"])" />
