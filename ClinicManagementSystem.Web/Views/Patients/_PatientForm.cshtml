@model ClinicManagementSystem.Web.Models.ViewModels.Patients.PatientFormViewModel

<div class="mb-3">
    <label asp-for="PatientCode" class="form-label">Mã bệnh nhân</label>
    <input asp-for="PatientCode" class="form-control" readonly />
    <span asp-validation-for="PatientCode" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="FullName" class="form-label">Họ và tên</label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
    @{
        var birthText = ViewData.ModelState.TryGetValue("DateOfBirth", out var birthEntry)
            ? birthEntry.AttemptedValue : Model.DateOfBirth?.ToString("dd/MM/yyyy");
    }
    <input id="DateOfBirth" name="DateOfBirth" value="@birthText" type="text" inputmode="numeric"
           placeholder="dd/mm/yyyy" maxlength="10" pattern="([0-9]{2}/[0-9]{2}/[0-9]{4}|[0-9]{8})"
           title="Nhập dd/mm/yyyy hoặc 8 số ddmmyyyy, ví dụ 27112003" autocomplete="bday" class="form-control" />
    <div class="form-text">Nhập nhanh 27112003 sẽ tự thành 27/11/2003.</div>
    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Gender" class="form-label">Giới tính</label>
    <select asp-for="Gender" class="form-select">
        <option value="">-- Chọn giới tính --</option>
        <option value="Male">Nam</option>
        <option value="Female">Nữ</option>
        <option value="Other">Khác</option>
    </select>
    <span asp-validation-for="Gender" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
    <input asp-for="PhoneNumber" class="form-control" />
    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    <div id="shared-phone-widget" data-url="@Url.Action("PhoneMatches", "Patients")" data-exclude-id="@ViewContext.RouteData.Values["id"]">
        <input type="hidden" asp-for="SharedPhoneWithPatientId" />
        <input type="hidden" asp-for="SharedPhoneRelationship" />
        <p id="shared-phone-status" class="small mt-2" role="status">
            @if (Model.SharedPhoneWithPatientId.HasValue) { <span>Đã xác nhận @Model.SharedPhoneRelationship của @Model.SharedPhoneOwnerName, dùng chung số điện thoại.</span> }
        </p>
        <button type="button" id="check-shared-phone" class="btn btn-outline-secondary btn-sm">Kiểm tra số điện thoại / Chọn người thân</button>
    </div>
</div>
<partial name="_SharedPhonePopup" />

<div class="mb-3">
    <label asp-for="Address" class="form-label">Địa chỉ</label>
    <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, thôn/ấp…" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>

<div data-vietnam-address data-provinces-url="@Url.Action("AddressProvinces", "Patients")" data-wards-url="@Url.Action("AddressWards", "Patients")" data-province="@Model.ProvinceCode" data-ward="@Model.WardCode">
    <div class="mb-3">
        <label asp-for="ProvinceCode" class="form-label">Tỉnh/thành phố</label>
        <select asp-for="ProvinceCode" class="form-select" data-search-picker="Tỉnh/thành phố" data-placeholder="Tìm tỉnh/thành phố…" data-optional="true" disabled><option value="">-- Chọn tỉnh/thành phố --</option></select>
        <span asp-validation-for="ProvinceCode" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="WardCode" class="form-label">Xã/phường</label>
        <select asp-for="WardCode" class="form-select" data-search-picker="Xã/phường" data-placeholder="Chọn tỉnh/thành phố trước…" data-optional="true" disabled><option value="">-- Chọn xã/phường --</option></select>
        <span asp-validation-for="WardCode" class="text-danger"></span>
    </div>
    <p class="text-muted small">Danh mục hành chính sau sáp nhập 07/2025. Có thể tìm kiếm không dấu.</p>
    <p data-address-status role="status" class="text-danger"></p>
    <button type="button" data-address-retry class="btn btn-outline-secondary mb-3" hidden>Thử tải lại danh mục</button>
</div>

<div class="mb-3">
    <label asp-for="Occupation" class="form-label">Nghề nghiệp</label>
    <input asp-for="Occupation" class="form-control" />
    <span asp-validation-for="Occupation" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Notes" class="form-label">Ghi chú</label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Status" class="form-label">Trạng thái</label>
    <select asp-for="Status" class="form-select">
        <option value="Active">Đang hoạt động</option>
        <option value="Inactive">Ngừng hoạt động</option>
    </select>
    <span asp-validation-for="Status" class="text-danger"></span>
</div>
