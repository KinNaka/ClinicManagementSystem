@model ClinicManagementSystem.Web.ViewModels.Inventory.StockInViewModel
@{ ViewData["Title"] = "Nhập kho"; }
<h2>Nhập kho</h2>
<a asp-action="Receipts" class="btn btn-outline-success mb-3">Danh sách phiếu nhập</a>
<form asp-action="StockIn" method="post" data-stock-form>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <label asp-for="ReferenceNumber" class="form-label">Số hóa đơn / chứng từ</label>
    <input asp-for="ReferenceNumber" class="form-control mb-3" />
    <label asp-for="Reason" class="form-label">Lý do nhập</label>
    <input asp-for="Reason" class="form-control mb-3" />
    <partial name="_StockRows" model="@((Model.Details, Model.Products, true))" />
    <button type="submit" class="btn btn-success">Lưu phiếu nhập</button>
    <a asp-action="Receipts" class="btn btn-secondary">Hủy</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/search-picker.js" asp-append-version="true"></script><script src="~/js/stock-form.js" asp-append-version="true"></script> }
