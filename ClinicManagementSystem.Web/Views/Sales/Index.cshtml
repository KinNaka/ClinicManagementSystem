
@model ClinicManagementSystem.Web.Models.ViewModels.Sales.SaleIndexViewModel

@{
    ViewData["Title"] = "Quản lý bán hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý bán hàng</h2>

    <a asp-controller="Sales"
       asp-action="Create"
       class="btn btn-primary">
        + Tạo hóa đơn
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-controller="Sales"
      asp-action="Index"
      method="get"
      class="row g-2 mb-3">

    <div class="col-md-5">
        <input type="text"
               name="searchTerm"
               value="@Model.SearchTerm"
               class="form-control"
               placeholder="Mã hóa đơn, mã hoặc tên bệnh nhân..." />
    </div>

    <div class="col-md-3">
        <select name="statusFilter" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="Draft"
                    selected="@(Model.StatusFilter == "Draft")">
                Hóa đơn nháp
            </option>
            <option value="Confirmed"
                    selected="@(Model.StatusFilter == "Confirmed")">
                Đã xác nhận
            </option>
        </select>
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Xóa lọc
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã hóa đơn</th>
                <th>Ngày bán</th>
                <th>Mã bệnh nhân</th>
                <th>Họ và tên</th>
                <th class="text-end">Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Sales.Count == 0)
            {
                <tr>
                    <td colspan="7"
                        class="text-center text-muted py-4">
                        Không tìm thấy hóa đơn.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td>@sale.SaleCode</td>
                        <td>
                            @sale.SaleDate.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>@sale.PatientCode</td>
                        <td>@sale.PatientName</td>
                        <td class="text-end">
                            @sale.TotalAmount.ToString("N0") đ
                        </td>
                        <td>
                            @if (sale.Status == "Draft")
                            {
                                <span class="badge bg-warning text-dark">
                                    Nháp
                                </span>
                            }
                            else if (sale.Status == "Confirmed")
                            {
                                <span class="badge bg-success">
                                    Đã xác nhận
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @sale.Status
                                </span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Details"
                                   asp-route-id="@sale.Id"
                                   class="btn btn-sm btn-outline-info">
                                    Xem
                                </a>

                                @if (sale.Status == "Draft")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@sale.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
