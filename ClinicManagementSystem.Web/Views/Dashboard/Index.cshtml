@model ClinicManagementSystem.Web.Models.ViewModels.Dashboard.DashboardViewModel
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tổng quan";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time"));
    var days = Model.RevenueLast7Days.OrderBy(x => x.Date).ToList();
    var total = days.Sum(x => x.Revenue);
    var peak = days.Count > 0 ? days.Max(x => x.Revenue) : 0;
    var average = days.Count > 0 ? total / days.Count : 0;
}
<div class="dashboard-heading">
    <div><p class="eyebrow">KHÔNG GIAN LÀM VIỆC</p><h1>Tổng quan phòng khám</h1><p class="muted">Các thông tin quan trọng, trong một góc nhìn.</p></div>
    <a class="action primary" asp-controller="Sales" asp-action="Create"><span aria-hidden="true">＋</span> Tạo hóa đơn</a>
</div>
<section class="welcome-banner" aria-label="Thông tin hôm nay">
    <div><span class="today-label">HÔM NAY · @now.ToString("dd/MM/yyyy")</span><h2>Sẵn sàng cho một ngày làm việc mới</h2><p>Theo dõi hoạt động và chăm sóc bệnh nhân từ đây.</p></div>
    <a class="action banner-action" asp-controller="Patients" asp-action="Create">＋ Thêm bệnh nhân</a>
    <span class="banner-decoration" aria-hidden="true">＋</span>
</section>
<section class="metric-grid" aria-label="Số liệu tổng quan">
    <a class="metric" asp-controller="Patients" asp-action="Index"><div class="metric-top"><span class="metric-icon teal" aria-hidden="true">♧</span><span class="metric-arrow" aria-hidden="true">↗</span></div><span class="metric-label">Tổng bệnh nhân</span><strong>@Model.TotalPatients.ToString("N0", culture)</strong><span class="metric-caption">Xem hồ sơ bệnh nhân</span></a>
    <a class="metric" asp-controller="Products" asp-action="Index"><div class="metric-top"><span class="metric-icon blue" aria-hidden="true">▦</span><span class="metric-arrow" aria-hidden="true">↗</span></div><span class="metric-label">Tổng sản phẩm</span><strong>@Model.TotalProducts.ToString("N0", culture)</strong><span class="metric-caption">Danh mục sản phẩm</span></a>
    <a class="metric" asp-controller="Inventory" asp-action="Index"><div class="metric-top"><span class="metric-icon amber" aria-hidden="true">!</span><span class="metric-arrow" aria-hidden="true">↗</span></div><span class="metric-label">Sản phẩm tồn kho thấp</span><strong class="warning-number">@Model.LowStockProducts.ToString("N0", culture)</strong><span class="metric-caption">Tồn kho ≤ mức tối thiểu</span></a>
    <a class="metric revenue-metric" asp-controller="Sales" asp-action="Index"><div class="metric-top"><span class="metric-icon teal" aria-hidden="true">₫</span><span class="metric-arrow" aria-hidden="true">↗</span></div><span class="metric-label">Giá trị hóa đơn hôm nay</span><strong>@Model.TodayRevenue.ToString("N0", culture)<small> ₫</small></strong><span class="metric-caption">@Model.TodaySalesCount.ToString("N0", culture) hóa đơn đã xác nhận</span></a>
</section>
<div class="dashboard-columns">
    <section class="panel revenue-panel" aria-labelledby="revenue-title">
        <div class="panel-heading"><div><h2 id="revenue-title">Giá trị hóa đơn</h2><p class="muted">Hoạt động trong 7 ngày gần nhất</p></div><span class="period-label">7 ngày gần nhất</span></div>
        <div class="chart-summary"><div><span class="muted">Tổng giá trị</span><strong>@total.ToString("N0", culture) <small>₫</small></strong></div><div><span class="muted">Trung bình / ngày</span><b>@average.ToString("N0", culture) ₫</b></div></div>
        @if (days.Count > 0)
        {
            <div class="revenue-chart" role="group" aria-label="Giá trị hóa đơn theo ngày, đơn vị đồng">
                @foreach (var day in days)
                {
                    var height = peak > 0 ? Math.Max(2, day.Revenue / peak * 100) : 0;
                    <div class="chart-column @(day.Date.Date == now.Date ? "current-day" : "")">
                        <span class="bar-value">@day.Revenue.ToString("N0", culture)</span>
                        <div class="bar-track"><div class="bar" style="height: @(height.ToString(CultureInfo.InvariantCulture))%" title="@day.Date.ToString("dd/MM"): @day.Revenue.ToString("N0", culture) ₫"></div></div>
                        <span class="bar-date">@day.Date.ToString("dd/MM")</span>
                    </div>
                }
            </div>
            @if (peak == 0) { <p class="empty-chart">Chưa có hóa đơn xác nhận trong 7 ngày này.</p> }
        }
        else
        {
            <p class="empty-chart">Chưa có dữ liệu để hiển thị biểu đồ.</p>
        }
        <div class="chart-footer"><span><i aria-hidden="true"></i> Hóa đơn đã xác nhận</span><a asp-controller="Sales" asp-action="Index">Xem hóa đơn →</a></div>
    </section>
    <div class="side-panels">
        <section class="panel" aria-labelledby="quick-title"><div class="panel-heading"><div><h2 id="quick-title">Thao tác nhanh</h2><p class="muted">Bắt đầu công việc thường ngày</p></div></div>
            <div class="quick-links">
                <a asp-controller="Patients" asp-action="Create"><span class="quick-icon teal" aria-hidden="true">＋</span><span><b>Thêm bệnh nhân</b><small>Tạo hồ sơ mới</small></span><span aria-hidden="true">→</span></a>
                <a asp-controller="Sales" asp-action="Create"><span class="quick-icon blue" aria-hidden="true">▤</span><span><b>Tạo hóa đơn</b><small>Ghi nhận giao dịch</small></span><span aria-hidden="true">→</span></a>
                <a asp-controller="Inventory" asp-action="Index"><span class="quick-icon violet" aria-hidden="true">▦</span><span><b>Kiểm tra tồn kho</b><small>Theo dõi số lượng sản phẩm</small></span><span aria-hidden="true">→</span></a>
            </div>
        </section>
        <section class="stock-notice @(Model.LowStockProducts > 0 ? "needs-attention" : "stock-good")" aria-labelledby="stock-title"><span class="notice-icon" aria-hidden="true">@(Model.LowStockProducts > 0 ? "!" : "✓")</span><h2 id="stock-title">@(Model.LowStockProducts > 0 ? "Kho hàng cần chú ý" : "Tồn kho ổn định")</h2><p>@(Model.LowStockProducts > 0 ? $"Có {Model.LowStockProducts.ToString("N0", culture)} sản phẩm chạm mức tồn kho tối thiểu. Kiểm tra để lên kế hoạch bổ sung." : "Hiện không có sản phẩm đang hoạt động nào chạm mức tồn kho tối thiểu.")</p><a asp-controller="Inventory" asp-action="Index">Xem kho hàng <span aria-hidden="true">→</span></a></section>
    </div>
</div>
<p class="data-note"><span aria-hidden="true">ⓘ</span> Giá trị hóa đơn phản ánh các hóa đơn đã xác nhận, chưa phải tiền thực thu.</p>
