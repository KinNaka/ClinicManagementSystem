@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isDashboard = controller == "Dashboard";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var sections = new[] {
        (Controller: "Dashboard", Label: "Tổng quan", Icon: "◫"),
        (Controller: "Patients", Label: "Bệnh nhân", Icon: "♧"),
        (Controller: "Products", Label: "Sản phẩm", Icon: "▦"),
        (Controller: "ProductCategories", Label: "Danh mục sản phẩm", Icon: "≡"),
        (Controller: "Inventory", Label: "Kho hàng", Icon: "▣"),
        (Controller: "Sales", Label: "Hóa đơn", Icon: "▤"),
        (Controller: "UserManagement", Label: "Tài khoản", Icon: "⚙")
    };
    var sectionName = sections.FirstOrDefault(x => x.Controller == controller).Label ?? "Phòng khám";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Clinic Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clinic.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "clinic-app" : "auth-page")">
    <a href="#main-content" class="skip-link">Đến nội dung chính</a>
    @if (signedIn)
    {
        <div class="dashboard-shell">
            <aside class="sidebar">
                <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-symbol" aria-hidden="true">＋</span><span>Clinic<span class="brand-subtitle">MANAGEMENT SYSTEM</span></span></a>
                <p class="nav-caption">QUẢN LÝ PHÒNG KHÁM</p>
                <nav class="main-nav" aria-label="Điều hướng chính">
                    @foreach (var navItem in sections)
                    {
                        if (navItem.Controller == "UserManagement" && !User.IsInRole("Admin")) { continue; }
                        <a class="@(controller == navItem.Controller ? "active" : "")" aria-current="@(controller == navItem.Controller ? "page" : null)" asp-controller="@navItem.Controller" asp-action="Index"><span aria-hidden="true">@navItem.Icon</span>@navItem.Label</a>
                    }
                </nav>
                <div class="sidebar-bottom"><span class="status-dot" aria-hidden="true"></span> Không gian quản lý phòng khám</div>
            </aside>
            <div class="workspace">
                <header class="topbar">
                    <div class="breadcrumb">Phòng khám <span aria-hidden="true">/</span> <b>@sectionName</b></div>
                    <div class="user-menu"><span class="avatar" aria-hidden="true">@(User.IsInRole("Admin") ? "AD" : "NV")</span><span class="user-details"><b>@User.Identity?.Name</b><small>@(User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên")</small></span><form asp-controller="Account" asp-action="Logout" method="post"><button class="logout" type="submit">Đăng xuất</button></form></div>
                </header>
                <main id="main-content" class="dashboard-main @(isDashboard ? "" : "management-page")">
                    @if (!isDashboard) { <p class="eyebrow page-eyebrow">@sectionName</p> }
                    @RenderBody()
                </main>
                <footer class="dashboard-footer">Clinic Management <span>Chăm sóc tốt hơn, quản lý dễ hơn.</span></footer>
            </div>
        </div>
    }
    else
    {
        <header class="auth-header"><a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-symbol" aria-hidden="true">＋</span><span>Clinic<span class="brand-subtitle">MANAGEMENT SYSTEM</span></span></a><span>Chăm sóc tốt hơn, quản lý dễ hơn.</span></header>
        <main id="main-content" class="auth-main">@RenderBody()</main>
        <footer class="auth-footer">Clinic Management · Không gian quản lý phòng khám</footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
