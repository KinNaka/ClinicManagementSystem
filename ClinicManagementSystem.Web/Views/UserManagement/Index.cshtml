@model List<ClinicManagementSystem.Web.Models.ViewModels.UserManagement.UserListViewModel>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý tài khoản nhân viên</h2>
    <div class="d-flex gap-2"><a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary">Đổi mật khẩu của tôi</a>
    <a asp-action="Create" class="btn btn-primary">+ Tạo tài khoản</a></div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th style="min-width:280px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Đã khóa</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @if (user.Role.Split(", ", StringSplitOptions.RemoveEmptyEntries).Contains("Staff") && !user.Role.Split(", ", StringSplitOptions.RemoveEmptyEntries).Contains("Admin") && user.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                            {
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa tài khoản Staff này? Tài khoản sẽ không thể đăng nhập lại.');">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Xóa tài khoản</button>
                                </form>
                            }
                            <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <select name="role" class="form-select form-select-sm" aria-label="Vai trò">
                                    <option value="Staff" selected="@(user.Role == "Staff")">Staff</option>
                                    <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                                </select>
                                <button type="submit" class="btn btn-outline-primary btn-sm">Lưu quyền</button>
                            </form>
                            <form asp-action="ToggleActive" method="post"
                                  onsubmit="return confirm('Bạn chắc chắn muốn thay đổi trạng thái tài khoản này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(user.IsActive ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Chưa có tài khoản nào.</p>
}

<partial name="_ListPaging" model="@((ClinicManagementSystem.Web.Services.ListPaging?)ViewData["Paging"])" />
