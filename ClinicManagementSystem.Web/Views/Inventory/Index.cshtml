@model List<ClinicManagementSystem.Web.ViewModels.Inventory.InventoryIndexViewModel>

@{
    ViewData["Title"] = "Quản lý kho";
}

<h2>Quản lý kho thuốc và vật tư</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<form method="get" data-live-filter data-results-id="filter-results" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <input type="text"
               name="searchTerm"
               value="@ViewBag.SearchTerm"
               class="form-control"
               placeholder="Tìm theo mã hoặc tên sản phẩm..." />
    </div>

    <div class="col-md-3">
        <select name="lowStockOnly" class="form-select" aria-label="Lọc tồn kho">
            <option value="false" selected="@(!(bool)(ViewBag.LowStockOnly ?? false))">Tất cả hàng hóa</option>
            <option value="true" selected="@((bool)(ViewBag.LowStockOnly ?? false))">Sắp hết hàng (tồn ≤ tối thiểu)</option>
        </select>
    </div>
    <partial name="_ListSort" model="@(new ClinicManagementSystem.Web.Services.ListSortOptions(NameLabel: "Tên"))" />
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" data-filter-reset class="btn btn-outline-secondary">Đặt lại</a>
    </div>
</form>

<div class="mb-3">
    @if (User.IsInRole("Admin")) { <a asp-action="StockCount" class="btn btn-primary">Kiểm kho / Cân kho</a> }
    <a asp-action="StockIn" class="btn btn-success">Nhập kho</a>
    <a asp-action="Receipts" class="btn btn-outline-success">Danh sách phiếu nhập</a>
    <a asp-action="StockOut" class="btn btn-warning">Xuất kho</a>
    <a asp-action="Transactions" class="btn btn-outline-primary">
        Lịch sử giao dịch
    </a>
</div>

<div id="filter-results" data-filter-results>
<div class="table-responsive">
    <table data-mobile-cards class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã hàng</th>
                <th>Tên sản phẩm</th>
                <th>Đơn vị</th>
                <th class="text-end">Tồn kho</th>
                <th class="text-end">Tồn tối thiểu</th>
                <th class="text-end">Giá vốn</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductCode</td>
                <td>@item.ProductName</td>
                <td>@item.Unit</td>
                <td class="text-end">@item.CurrentStock.ToString("0.###")</td>
                <td class="text-end">@item.MinimumStock.ToString("0.###")</td>
                <td class="text-end">@item.CostPrice.ToString("N0")</td>
                <td>
                    @if (item.IsLowStock)
                    {
                        <span class="badge bg-danger">Sắp hết hàng</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Đủ hàng</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_ListPaging" model="@((ClinicManagementSystem.Web.Services.ListPaging?)ViewData["Paging"])" />
</div>
