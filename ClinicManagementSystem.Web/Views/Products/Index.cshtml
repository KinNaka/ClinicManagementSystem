
@model List<ClinicManagementSystem.Web.Models.ViewModels.Products.ProductListViewModel>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Quản lý sản phẩm</h2>
        <p class="text-muted mb-0">
            Quản lý thuốc và vật tư phòng khám.
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
    <div class="d-flex gap-2">
    <a asp-action="History" class="btn btn-outline-secondary">Lịch sử chỉnh sửa</a>
    <a asp-controller="ProductImports" asp-action="Index" class="btn btn-outline-primary">Nhập từ KiotViet</a>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm sản phẩm
    </a>
    </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<nav class="nav nav-tabs mb-3" aria-label="Phạm vi sản phẩm">
    <a asp-action="Index" class="nav-link @((bool?)ViewBag.Archived != true ? "active" : "")">Đang kinh doanh</a>
    <a asp-action="Index" asp-route-archived="true" class="nav-link @((bool?)ViewBag.Archived == true ? "active" : "")">Lưu trữ</a>
</nav>
@if ((bool?)ViewBag.Archived == true && User.IsInRole("Admin"))
{
    <a asp-controller="Inventory" asp-action="StockCount" asp-route-archived="true" class="btn btn-outline-primary mb-3">Kiểm / cân kho hàng lưu trữ còn tồn</a>
}
<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Index" method="get" data-live-filter data-results-id="filter-results" class="row g-2 align-items-end mb-4">
            <div class="col-md-5">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Tìm theo mã hoặc tên sản phẩm..." />
            </div>

            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id"
                                selected="@(ViewBag.CategoryId != null &&
                                                                 (long)ViewBag.CategoryId == category.Id)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <input type="hidden" name="archived" value="@(((bool?)ViewBag.Archived == true).ToString().ToLowerInvariant())" />

            <partial name="_ListSort" model="@(new ClinicManagementSystem.Web.Services.ListSortOptions(NameLabel: "Tên"))" />
    <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                <a asp-action="Index" asp-route-archived="@ViewBag.Archived" data-filter-reset class="btn btn-outline-secondary">Đặt lại</a>
            </div>
        </form>

        <div id="filter-results" data-filter-results>
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">
                    Không tìm thấy sản phẩm.
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-primary">Thêm sản phẩm đầu tiên</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table data-mobile-cards class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã sản phẩm</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá vốn</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.ProductCode</td>

                                <td>
                                    <strong>@product.Name</strong> @if (product.IsCombo) { <span class="badge bg-info">Combo</span> } @if (product.IsService) { <span class="badge bg-secondary">Dịch vụ</span> }
                                </td>

                                <td>@product.CategoryName</td>

                                <td>
                                    @product.CostPrice.ToString("N0")
                                </td>

                                <td>
                                    @product.SellingPrice.ToString("N0")
                                </td>

                                <td>
                                    @product.CurrentStock.ToString("0.###")
                                    @product.Unit
                                </td>

                                <td>
                                    @if ((product.Status is "Active" or "ACTIVE"))
                                    {
                                        <span class="badge bg-success">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>

                                <td class="text-end text-nowrap">
                                    @if (User.IsInRole("Admin"))
                            {
                            <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>

                                    <form asp-action="ToggleStatus" asp-route-archived="@ViewBag.Archived"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm @((product.Status is "Active" or "ACTIVE") ? "btn-warning" : "btn-success")"
                                                onclick="return confirm('Bạn có muốn thay đổi trạng thái sản phẩm này?');">
                                            @((product.Status is "Active" or "ACTIVE") ? "Ngừng hoạt động" : "Kích hoạt")
                                        </button>
                                    </form>

                                  @*   <form asp-action="Delete"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có muốn xóa sản phẩm này?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </button>
                                    </form>*@

                            }
                            </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <partial name="_ListPaging" model="@((ClinicManagementSystem.Web.Services.ListPaging?)ViewData["Paging"])" />
        </div>
    </div>
</div>
