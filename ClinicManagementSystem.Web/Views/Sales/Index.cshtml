
@model ClinicManagementSystem.Web.Models.ViewModels.Sales.SaleIndexViewModel

@{
    ViewData["Title"] = "Quản lý bán hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý bán hàng</h2>

    <div class="d-flex flex-wrap gap-2"><a asp-controller="Inventory" asp-action="Receipts" class="btn btn-outline-success">Phiếu nhập kho</a><a asp-controller="Inventory" asp-action="Transactions" class="btn btn-outline-secondary">Phiếu kho / Tra cứu sử dụng</a><a asp-controller="SaleImports" asp-action="Index" class="btn btn-outline-primary">Nhập hóa đơn KiotViet</a>
    <a asp-controller="Sales"
       asp-action="Create"
       class="btn btn-primary">
        + Tạo hóa đơn
    </a></div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-controller="Sales"
      asp-action="Index"
      method="get" data-live-filter data-results-id="filter-results"
      class="row g-2 align-items-end mb-3">

    <div class="col-md-5">
        <input type="text"
               name="searchTerm"
               value="@Model.SearchTerm"
               class="form-control"
               placeholder="Mã hóa đơn, sản phẩm hoặc bệnh nhân..." />
    </div>

    <div class="col-md-3">
        <select name="statusFilter" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="Imported" selected="@(Model.StatusFilter == "Imported")">Lịch sử KiotViet</option>
            <option value="Draft"
                    selected="@(Model.StatusFilter == "Draft")">
                Hóa đơn nháp
            </option>
            <option value="Confirmed"
                    selected="@(Model.StatusFilter == "Confirmed")">
                Đã xác nhận
            </option>
        </select>
    </div>

    <partial name="_DatePeriod" />
    <partial name="_ListSort" model="@(new ClinicManagementSystem.Web.Services.ListSortOptions(NameLabel: "Mã hóa đơn"))" />
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        <a asp-action="Index" data-filter-reset
           class="btn btn-outline-secondary">
            Xóa lọc
        </a>
    </div>
</form>

<div id="filter-results" data-filter-results>
<div class="table-responsive">
    <table data-mobile-cards class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã hóa đơn</th>
                <th>Ngày bán</th>
                <th>Mã bệnh nhân</th>
                <th>Họ và tên</th>
                <th class="text-end">Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Sales.Count == 0)
            {
                <tr>
                    <td colspan="7"
                        class="text-center text-muted py-4">
                        Không tìm thấy hóa đơn.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td>@sale.SaleCode</td>
                        <td>
                            @sale.SaleDate.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>@sale.PatientCode</td>
                        <td>@sale.PatientName</td>
                        <td class="text-end">
                            @sale.TotalAmount.ToString("N0") đ
                        </td>
                        <td>
                            @if (sale.Status == "Draft")
                            {
                                <span class="badge bg-warning text-dark">
                                    Nháp
                                </span>
                            }
                            else if (sale.Status == "Confirmed")
                            {
                                <span class="badge bg-success">
                                    Đã xác nhận
                                </span>
                            }
                            else if (sale.Status == "Imported") { <span class="badge bg-info text-dark">Lịch sử KiotViet</span> }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @sale.Status
                                </span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Details"
                                   asp-route-id="@sale.Id"
                                   class="btn btn-sm btn-outline-info">
                                    Xem
                                </a>

                                @if (sale.Status == "Draft")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@sale.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>
                                }
                                @if (User.IsInRole("Admin") || (User.IsInRole("Staff") && sale.Status == "Draft"))
                                {
                                    <form asp-action="Delete" asp-route-id="@sale.Id" method="post"
                                          onsubmit="return confirm(this.dataset.confirm);" data-confirm="@(sale.Status == "Draft" ? "Xóa hóa đơn nháp này?" : "Xóa hóa đơn này? Hóa đơn đã xác nhận sẽ được trừ khỏi doanh thu và hoàn kho theo phiếu xuất gốc. Hóa đơn lịch sử KiotViet không hoàn kho.")">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="text-muted">@Model.TotalCount hóa đơn · Trang @Model.Page / @Model.TotalPages</span>
    <nav aria-label="Phân trang hóa đơn"><ul class="pagination mb-0">
        @if (Model.Page > 1)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-sort="@Context.Request.Query["sort"]" asp-route-page="@(Model.Page - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-period="@Context.Request.Query["period"]">Trước</a></li>
        }
        @for (var pageNumber = Math.Max(1, Model.Page - 2); pageNumber <= Math.Min(Model.TotalPages, Model.Page + 2); pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-sort="@Context.Request.Query["sort"]" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-period="@Context.Request.Query["period"]">@pageNumber</a></li>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-sort="@Context.Request.Query["sort"]" asp-route-page="@(Model.Page + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-period="@Context.Request.Query["period"]">Sau</a></li>
        }
    </ul></nav>
</div>
</div>
