@using ClinicManagementSystem.Web.Services
@model List<ClinicManagementSystem.Web.Entities.InventoryTransaction>

@{
    ViewData["Title"] = "Lịch sử kho";
}

<h2>Lịch sử giao dịch kho</h2>

<a asp-action="Index" class="btn btn-secondary mb-3">Quay lại kho</a>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Mã phiếu</th>
                <th>Loại giao dịch</th>
                <th>Ngày giờ</th>
                <th>Lý do</th>
                <th>Người thực hiện</th>
                <th>Số mặt hàng</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var transaction in Model)
        {
            <tr>
                <td>@transaction.TransactionCode</td>
                <td>
                    @(transaction.TransactionType == "StockIn"
                        ? "Nhập kho"
                        : transaction.TransactionType == "StockOut"
                            ? "Xuất kho"
                            : "Điều chỉnh")
                </td>
                <td>@transaction.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@transaction.Reason</td>
                <td>@transaction.CreatedBy</td>
                <td><details><summary>@transaction.Details.Count mặt hàng</summary>
                    <table class="table table-sm mt-2"><thead><tr><th>Hàng hóa</th><th>Số lượng / chênh lệch</th><th>Ghi chú</th></tr></thead><tbody>
                    @{ var key = "detailsPage" + transaction.Id; var detailsPaging = new ListPaging(int.TryParse(Context.Request.Query[key], out var requested) ? requested : 1, key); var visibleDetails = detailsPaging.Slice(transaction.Details.OrderBy(d => d.Id)).ToList(); }
                    @foreach (var detail in visibleDetails)
                    {
                        <tr><td>@detail.Product.ProductCode — @detail.Product.Name</td><td>@detail.Quantity.ToString("0.###")</td><td>@detail.Note</td></tr>
                    }
                    </tbody></table><partial name="_ListPaging" model="detailsPaging" />
                </details></td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_ListPaging" model="@((ClinicManagementSystem.Web.Services.ListPaging?)ViewData["Paging"])" />
