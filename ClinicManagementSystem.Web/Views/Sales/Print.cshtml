@model ClinicManagementSystem.Web.Models.ViewModels.Sales.SaleDetailsViewModel
@{
    Layout = null;
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => value.ToString("N0", culture);
    var goods = Model.Status == "Imported" ? Model.ImportedGoodsTotal : Model.Details.Sum(d => d.LineTotal);
    var printTime = DateTime.UtcNow.AddHours(7);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hóa đơn @Model.SaleCode</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #edf0f3; color: #000; font-family: Arial, sans-serif; }
        .toolbar { max-width: 680px; margin: 20px auto; padding: 16px; background: white; border-radius: 8px; font-size: 14px; }
        .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
        button, select, .back { font: inherit; padding: 8px 12px; }
        button { background: #1459bd; color: white; border: 0; border-radius: 4px; cursor: pointer; }
        .back { color: #1459bd; }
        .help { line-height: 1.5; margin: 12px 0 0; }
        #receipt { width: 80mm; padding: 0 3mm 3mm; margin: 0 auto 24px; background: white; }
        #receipt.narrow { width: 58mm; }
        .printBox { font-family: Arial, sans-serif; font-size: 11px; line-height: 1.4; }
        .printBox span { font-size: 12px; }
        .printBox table { width: 100%; page-break-inside: auto; border-collapse: collapse; }
        .printBox td { overflow-wrap: anywhere; vertical-align: top; }
        .printBox tr { page-break-inside: avoid; page-break-after: auto; }
        .printBox img { max-width: 100%; height: auto; }
        .heading { padding-top: 10px; text-align: center; }
        .customer { margin: 10px 0 15px; }
        .amounts { margin-top: 20px; width: 98% !important; font-weight: bold; }
        .amounts td { padding: 3px; text-align: right; }
        .amounts .label { white-space: nowrap; }
        .amounts .value { white-space: nowrap; }
        .thanks { margin-top: 20px; text-align: center; font-style: italic; }
        @@media print {
            html, body { background: white; margin: 0 !important; padding: 0 !important; }
            .toolbar { display: none !important; }
            #receipt, #receipt.narrow { width: 100%; max-width: 74mm; margin: 0 auto; padding: 0 0 3mm; }
            #receipt.narrow { max-width: 52mm; }
            tr, .customer, .thanks { break-inside: avoid; }
        }
    </style>
    <style>@@page { size: auto; margin: 0 3mm; }</style>
</head>
<body>
    <div class="toolbar">
        <div class="controls">
            <label for="paper-width">Khổ giấy POS</label>
            <select id="paper-width"><option value="80">80 mm</option><option value="58">58 mm</option></select>
            <button type="button" id="print-receipt">In hóa đơn</button>
            <a class="back" asp-action="Details" asp-route-id="@Model.Id">Quay lại hóa đơn</a>
        </div>
        <p class="help">Chọn máy in POS và đúng khổ giấy trong hộp thoại in. Đặt tỷ lệ 100%, giữ lề “Mặc định”, tắt đầu trang và chân trang. Mẫu in đặt lề trái/phải 3 mm và lề trên/dưới 0 mm để nội dung nằm giữa khổ giấy.</p>
    </div>
    <main id="receipt" class="printBox">
        <span id="print-time">@printTime.ToString("dd/MM/yyyy HH:mm")</span>
        <div class="heading"><span><strong>@(Model.Status == "Draft" ? "HÓA ĐƠN TẠM TÍNH" : "HÓA ĐƠN BÁN HÀNG")</strong></span></div>
        <table><tbody>
            <tr><td style="text-align:center"><span>Số HĐ: @Model.SaleCode</span></td></tr>
            <tr><td style="text-align:center"><span>Ngày @(Model.DisplayDate?.ToString("dd 'tháng' MM 'năm' yyyy") ?? "Chưa xác nhận")</span></td></tr>
        </tbody></table>
        <table class="customer"><tbody>
            <tr><td><span>Khách hàng: @(string.IsNullOrWhiteSpace(Model.PatientName) ? "Khách lẻ" : Model.PatientName)</span></td></tr>
            <tr><td><span>SĐT: @(string.IsNullOrWhiteSpace(Model.PatientPhone) ? "—" : Model.PatientPhone)</span></td></tr>
        </tbody></table>
        <table class="amounts" aria-label="Tổng tiền hóa đơn"><tfoot>
            <tr><td class="label"><span>Tổng tiền:</span></td><td class="value"><span>@Money(goods)</span></td></tr>
            @if (Model.ImportedDiscount != 0)
            {
                <tr><td class="label"><span>Giảm giá:</span></td><td class="value"><span>@Money(Model.ImportedDiscount)</span></td></tr>
            }
            <tr><td class="label"><span>Tiền thu khác:</span></td><td class="value"><span>@Money(Model.ImportedSurcharge)</span></td></tr>
            <tr><td class="label"><span>Thành tiền:</span></td><td class="value"><span>@Money(Model.TotalAmount)</span></td></tr>
        </tfoot></table>
        <table class="thanks"><tbody><tr><td><span>Cảm ơn và hẹn gặp lại!</span></td></tr></tbody></table>
    </main>
    <script>
        (() => {
            const width = document.getElementById('paper-width');
            const receipt = document.getElementById('receipt');
            function sizePaper() {
                const paperWidth = width.value === '58' ? 58 : 80;
                receipt.classList.toggle('narrow', paperWidth === 58);
            }
            try { width.value = localStorage.getItem('receipt-paper-width') === '58' ? '58' : '80'; } catch { }
            width.addEventListener('change', () => {
                try { localStorage.setItem('receipt-paper-width', width.value); } catch { }
                sizePaper();
            });
            function preparePrint() {
                document.getElementById('print-time').textContent = new Intl.DateTimeFormat('vi-VN', {
                    timeZone: 'Asia/Ho_Chi_Minh', day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
                }).format(new Date());
                sizePaper();
            }
            window.addEventListener('beforeprint', preparePrint);
            document.getElementById('print-receipt').addEventListener('click', () => { preparePrint(); window.print(); });
            sizePaper();
        })();
    </script>
</body>
</html>
