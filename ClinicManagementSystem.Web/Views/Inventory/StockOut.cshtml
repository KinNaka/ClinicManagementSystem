@model ClinicManagementSystem.Web.ViewModels.Inventory.StockOutViewModel
@{ ViewData["Title"] = "Xuất kho"; }
<h2>Xuất kho</h2>
<form asp-action="StockOut" method="post" data-stock-form>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <label asp-for="Reason" class="form-label">Lý do xuất</label>
    <select asp-for="Reason" class="form-select mb-3"><option>Xuất sử dụng</option><option>Xuất hủy</option><option>Xuất trả nhà cung cấp</option><option>Khác</option></select>
    <label asp-for="PatientId" class="form-label">Sử dụng cho bệnh nhân (nếu có)</label>
    <select asp-for="PatientId" asp-items="Model.Patients" data-search-picker="Bệnh nhân" data-optional="true" class="form-select mb-3"><option value="">Không gắn bệnh nhân</option></select>
    <p class="text-muted">Chọn bệnh nhân để lưu người sử dụng và thời gian xuất trên phiếu kho.</p>
    <partial name="_StockRows" model="@((Model.Details, Model.Products, false))" />
    <button class="btn btn-warning" type="submit">Lưu phiếu xuất</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/search-picker.js" asp-append-version="true"></script><script src="~/js/stock-form.js" asp-append-version="true"></script> }
