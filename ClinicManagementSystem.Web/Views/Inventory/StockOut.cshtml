@model ClinicManagementSystem.Web.ViewModels.Inventory.StockOutViewModel

@{
    ViewData["Title"] = "Xuất kho";
}

<h2>Xuất kho</h2>

<form asp-action="StockOut" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Lý do xuất</label>
        <select asp-for="Reason" class="form-select">
            <option value="Xuất sử dụng">Xuất sử dụng tại phòng khám</option>
            <option value="Xuất hủy">Xuất hủy</option>
            <option value="Xuất trả nhà cung cấp">Xuất trả nhà cung cấp</option>
            <option value="Khác">Khác</option>
        </select>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <h5>Chi tiết hàng xuất</h5>

    <div class="mb-3">
        <label class="form-label">Sản phẩm</label>
        <select asp-for="Details[0].ProductId"
                asp-items="Model.Products"
                class="form-select">
            <option value="">-- Chọn sản phẩm --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Số lượng xuất</label>
        <input asp-for="Details[0].Quantity"
               type="number"
               min="0.001"
               step="0.001"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Ghi chú</label>
        <input asp-for="Details[0].Note" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">Lưu phiếu xuất</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}