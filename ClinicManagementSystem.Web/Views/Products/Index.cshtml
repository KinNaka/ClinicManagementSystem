
@model List<ClinicManagementSystem.Web.Models.ViewModels.Products.ProductListViewModel>

@{
    ViewData["Title"] = "Product Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Product Management</h2>
        <p class="text-muted mb-0">
            Manage clinic medicines and supplies.
        </p>
    </div>

    <div class="d-flex gap-2">
    <a asp-controller="ProductImports" asp-action="Index" class="btn btn-outline-primary">Nhập từ KiotViet</a>
    <a asp-action="Create" class="btn btn-primary">
        + Add Product
    </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Index" method="get" data-live-filter data-results-id="filter-results" class="row g-2 mb-4">
            <div class="col-md-5">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by product code or name..." />
            </div>

            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id"
                                selected="@(ViewBag.CategoryId != null &&
                                                                 (long)ViewBag.CategoryId == category.Id)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="statusFilter" class="form-select">
                    <option value="">All statuses</option>
                    <option value="ACTIVE"
                            selected="@(ViewBag.StatusFilter as string == "ACTIVE")">
                        Active
                    </option>
                    <option value="INACTIVE"
                            selected="@(ViewBag.StatusFilter as string == "INACTIVE")">
                        Inactive
                    </option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" data-filter-reset class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>

        <div id="filter-results" data-filter-results>
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-3">
                    No products found.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    Create your first product
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product Code</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Cost Price</th>
                            <th>Selling Price</th>
                            <th>Current Stock</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.ProductCode</td>

                                <td>
                                    <strong>@product.Name</strong> @if (product.IsCombo) { <span class="badge bg-info">Combo</span> } @if (product.IsService) { <span class="badge bg-secondary">Dịch vụ</span> }
                                </td>

                                <td>@product.CategoryName</td>

                                <td>
                                    @product.CostPrice.ToString("N0")
                                </td>

                                <td>
                                    @product.SellingPrice.ToString("N0")
                                </td>

                                <td>
                                    @product.CurrentStock.ToString("N2")
                                    @product.Unit
                                </td>

                                <td>
                                    @if (product.Status == "ACTIVE")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="ToggleStatus"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm @(product.Status == "ACTIVE" ? "btn-warning" : "btn-success")"
                                                onclick="return confirm('Are you sure you want to change this product status?');">
                                            @(product.Status == "ACTIVE" ? "Inactive" : "Activate")
                                        </button>
                                    </form>

                                  @*   <form asp-action="Delete"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this product?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>*@
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </div>
</div>
