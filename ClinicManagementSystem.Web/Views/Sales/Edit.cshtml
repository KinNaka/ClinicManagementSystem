@model ClinicManagementSystem.Web.Models.ViewModels.Sales.SaleFormViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hóa đơn";
}

<h2 class="mb-4">Chỉnh sửa hóa đơn nháp</h2>

<form asp-controller="Sales" asp-action="Edit" asp-route-id="@Model.Id" method="post" id="saleForm" class="sale-entry-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CopyFromId" />
    @if (Model.CopyFromId.HasValue) { <div class="alert alert-info">Sao chép từ @Model.CopyFromCode. Giữ giá và ghi chú gốc; hóa đơn mới được lưu ở trạng thái nháp.</div> }
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card mb-3 sale-patient-card">
        <div class="card-header fw-bold">Thông tin bệnh nhân</div>
        <div class="card-body">
            <label asp-for="PatientId" class="form-label">Bệnh nhân</label>
            <select asp-for="PatientId" asp-items="Model.Patients" class="form-select" data-search-picker="Bệnh nhân">
                <option value="0">-- Chọn bệnh nhân --</option>
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>
    </div>

    <div class="card mb-3 sale-products-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Danh sách thuốc / vật tư</span>
        </div>
        <div class="card-body">
            <div class="sale-product-toolbar">
                <label for="productSearch" class="form-label">Tìm kiếm sản phẩm để thêm vào hóa đơn</label>
                <select id="productSearch" class="form-select" data-search-picker="Tìm sản phẩm" data-placeholder="Tìm mã hoặc tên sản phẩm…" data-optional="true">
                    <option value="">-- Tìm sản phẩm --</option>
                    @foreach (var p in Model.Products) { <option value="@p.Value">@p.Text</option> }
                </select>
            </div>
            <div class="table-responsive mt-3">
                <table data-mobile-cards class="table table-bordered align-middle" id="productTable">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:240px">Sản phẩm</th>
                            <th style="width:130px">Số lượng</th>
                            <th style="width:150px">Đơn giá</th>
                            <th style="width:150px">Thành tiền</th>
                            <th style="width:80px"></th>
                        </tr>
                    </thead>
                    <tbody id="productRows">
                        @for (int i = 0; i < Model.Details.Count; i++)
                        {
                            <tr data-source-id="@Model.Details[i].SourceDetailId" data-source-product="@Model.Details[i].ProductId" data-source-price="@Model.Details[i].UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-source-quantity="@Model.Details[i].PreservedQuantity.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture)" data-source-total="@Model.Details[i].PreservedLineTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <td>
                                    <input type="hidden" class="source-detail-id" name="Details[@i].SourceDetailId" value="@Model.Details[i].SourceDetailId" />
                                    <select name="Details[@i].ProductId" class="form-select product-select" data-search-picker="Sản phẩm" required>
                                        <option value="">-- Chọn sản phẩm --</option>
                                        @foreach (var p in Model.Products)
                                        {
                                            if (p.Value == Model.Details[i].ProductId.ToString())
                                            {
                                                <option value="@p.Value" selected>@(Model.Details[i].SourceDetailId > 0 ? Model.Details[i].ProductName : p.Text)</option>
                                            }
                                            else
                                            {
                                                <option value="@p.Value">@p.Text</option>
                                            }
                                        }
                                    </select>
                                    <textarea name="Details[@i].Notes" class="form-control line-notes mt-2" rows="1" maxlength="500" aria-label="Ghi chú sản phẩm" placeholder="Ghi chú riêng: cách dùng, yêu cầu…">@Model.Details[i].Notes</textarea>
                                </td>
                                <td>
                                    <div class="quantity-stepper" role="group" aria-label="Điều chỉnh số lượng">
                                        <button type="button" class="quantity-step" data-quantity-step="-1" aria-label="Giảm số lượng">−</button>
                                        <input name="Details[@i].Quantity" type="number" min="1" max="999999999" step="1" inputmode="numeric" aria-label="Số lượng sản phẩm"
                                           value="@Model.Details[i].Quantity.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture)"
                                           class="form-control quantity-input" required />
                                        <button type="button" class="quantity-step" data-quantity-step="1" aria-label="Tăng số lượng">+</button>
                                    </div>
                                </td>
                                <td class="text-end unit-price">—</td>
                                <td class="text-end line-total">—</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="productError" class="text-danger mb-2" role="alert"></div>
            <div class="row g-3 justify-content-end">
                <div class="col-md-3"><label for="DiscountType" class="form-label">Giảm giá theo</label>
                    <select asp-for="DiscountType" class="form-select"><option value="Amount">Số tiền (đ)</option><option value="Percent">Phần trăm (%)</option></select></div>
                <div class="col-md-3"><label asp-for="Discount" class="form-label">Mức giảm giá</label><input asp-for="Discount" type="number" min="0" step="0.01" max="999999999999" class="form-control" /><span asp-validation-for="Discount" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Surcharge" class="form-label">Thu khác (đ)</label><input asp-for="Surcharge" type="number" min="0" step="0.01" max="999999999999" class="form-control" /><span asp-validation-for="Surcharge" class="text-danger"></span></div>
            </div>
            <div class="text-end mt-3">Tiền hàng: <strong id="goodsTotal">0 đ</strong> · Giảm giá: <span id="discountTotal">0 đ</span></div>
            <div class="text-end fs-5">Thành tiền: <strong id="grandTotal">0 đ</strong></div>
            <small class="text-muted">Thành tiền = tiền hàng − giảm giá + thu khác. Dòng giữ nguyên sản phẩm giữ giá đã lưu; sản phẩm mới dùng giá hiện tại.</small>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold">Ghi chú</div>
        <div class="card-body">
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Lưu thay đổi</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy chỉnh sửa</a>
    </div>
</form>

<template id="rowTemplate">
    <tr>
        <td>
            <select class="form-select product-select" data-search-picker="Sản phẩm" required>
                <option value="">-- Chọn sản phẩm --</option>
                @foreach (var p in Model.Products)
                {
                    <option value="@p.Value">@p.Text</option>
                }
            </select>
            <textarea class="form-control line-notes mt-2" rows="1" maxlength="500" aria-label="Ghi chú sản phẩm" placeholder="Ghi chú riêng: cách dùng, yêu cầu…"></textarea>
        </td>
        <td>
            <div class="quantity-stepper" role="group" aria-label="Điều chỉnh số lượng">
                <button type="button" class="quantity-step" data-quantity-step="-1" aria-label="Giảm số lượng">−</button>
                <input type="number" min="1" max="999999999" step="1" inputmode="numeric" aria-label="Số lượng sản phẩm" value="1"
                   class="form-control quantity-input" required />
                <button type="button" class="quantity-step" data-quantity-step="1" aria-label="Tăng số lượng">+</button>
            </div>
        </td>
        <td class="text-end unit-price">—</td>
        <td class="text-end line-total">—</td>
        <td>
            <button type="button" class="btn btn-sm btn-outline-danger remove-row">Xóa</button>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/search-picker.js" asp-append-version="true"></script>
    <script src="~/js/quantity-stepper.js" asp-append-version="true"></script>
    <script src="~/js/sale-pricing.js" asp-append-version="true"></script>

    <script>
        (() => {
            const rows = document.getElementById("productRows");
            const template = document.getElementById("rowTemplate");
            const form = document.getElementById("saleForm");
            const error = document.getElementById("productError");
            const priceUrl = '@Url.Action("GetProductPrice", "Sales")';
            const formatter = new Intl.NumberFormat("vi-VN", {
                maximumFractionDigits: 2
            });

            const discountInput = document.getElementById("Discount");
            const discountType = document.getElementById("DiscountType");
            const surchargeInput = document.getElementById("Surcharge");
            function validQuantity(row, value) {
                return Number.isFinite(value) && value > 0 && value <= 999999999 &&
                    Number.isInteger(value);
            }
            function renumber() {
                window.ClinicQuantity.init(rows);
                [...rows.querySelectorAll("tr")].forEach((row, i) => {
                    row.querySelector(".product-select").name = `Details[${i}].ProductId`;
                    row.querySelector(".quantity-input").name = `Details[${i}].Quantity`;
                    row.querySelector(".line-notes").name = `Details[${i}].Notes`;
                    let source = row.querySelector(".source-detail-id");
                    if (!source) { source = document.createElement("input"); source.type = "hidden"; source.className = "source-detail-id"; row.querySelector("td").appendChild(source); }
                    source.name = `Details[${i}].SourceDetailId`;
                    source.value = row.dataset.sourceId || "0";
                });
            }

            function calculate() {
                let total = 0;

                rows.querySelectorAll("tr").forEach(row => {
                    const productId = row.querySelector(".product-select").value;
                    const quantity = Number(row.querySelector(".quantity-input").value);
                    const loaded = row.dataset.loadedProductId === productId && productId !== "";

                    if (loaded && validQuantity(row, quantity)) {
                        const price = Number(row.dataset.price);
                        const lineTotal = Number(row.dataset.sourceId) > 0 && quantity === Number(row.dataset.sourceQuantity) ? Number(row.dataset.sourceTotal) : Math.round((price * quantity + Number.EPSILON) * 100) / 100;
                        row.querySelector(".line-total").textContent = formatter.format(lineTotal) + " đ";
                        total += lineTotal;
                    } else {
                        row.querySelector(".line-total").textContent = "—";
                    }
                });

                const result = window.ClinicSalePricing.calculate(total, discountType.value, Number(discountInput.value), Number(surchargeInput.value));
                discountInput.max = discountType.value === "Percent" ? "100" : "999999999999";
                discountInput.setCustomValidity(result.error || "");
                document.getElementById("goodsTotal").textContent = formatter.format(total) + " đ";
                document.getElementById("discountTotal").textContent = formatter.format(result.discount) + " đ";
                document.getElementById("grandTotal").textContent = result.error ? "—" : formatter.format(result.total) + " đ";
            }

            async function updateRow(row) {
                const select = row.querySelector(".product-select");
                const productId = select.value;
                const requestVersion = (Number(row.dataset.requestVersion || 0) + 1);
                row.dataset.requestVersion = String(requestVersion);
                row.dataset.loadedProductId = "";
                row.dataset.price = "";
                row.querySelector(".unit-price").textContent = "—";
                calculate();

                if (!productId) return;
                if (Number(row.dataset.sourceId) > 0 && row.dataset.sourceProduct === productId) {
                    row.dataset.price = row.dataset.sourcePrice;
                    row.dataset.loadedProductId = productId;
                    row.querySelector(".unit-price").textContent = formatter.format(Number(row.dataset.price)) + " đ";
                    calculate();
                    return;
                }

                try {
                    const response = await fetch(`${priceUrl}?productId=${encodeURIComponent(productId)}`);
                    if (!response.ok) throw new Error("Không lấy được giá bán.");

                    const data = await response.json();
                    if (!row.isConnected || select.value !== productId ||
                        Number(row.dataset.requestVersion) !== requestVersion) return;

                    const price = Number(data.sellingPrice);
                    if (!Number.isFinite(price) || price < 0) throw new Error("Giá bán không hợp lệ.");

                    row.dataset.price = String(price);
                    row.dataset.loadedProductId = productId;
                    row.querySelector(".unit-price").textContent = formatter.format(price) + " đ";
                    calculate();
                } catch {
                    if (row.isConnected && select.value === productId &&
                        Number(row.dataset.requestVersion) === requestVersion) {
                        error.textContent = "Không thể tải giá bán sản phẩm. Vui lòng chọn lại sản phẩm.";
                        calculate();
                    }
                }
            }

            [discountInput, discountType, surchargeInput].forEach(input => input.addEventListener("input", calculate));
            const search = document.getElementById("productSearch");
            search.addEventListener("change", () => {
                if (!search.value) return;
                const id = search.value;
                let row = [...rows.querySelectorAll("tr")].find(r => r.querySelector(".product-select").value === id);
                if (row) {
                    const quantity = row.querySelector(".quantity-input");
                    quantity.value = String(Math.min(999999999, Number(quantity.value) + 1));
                    window.ClinicQuantity.init(rows);
                } else {
                    row = [...rows.querySelectorAll("tr")].find(r => !r.querySelector(".product-select").value);
                    if (!row) { rows.appendChild(template.content.cloneNode(true)); row = rows.lastElementChild; }
                    row.querySelector(".product-select").value = id;
                    window.ClinicSearchPicker.init(rows);
                    row.querySelector(".product-select").dispatchEvent(new Event("picker:refresh"));
                    renumber(); updateRow(row);
                }
                error.textContent = ""; calculate();
                search.value = ""; search.dispatchEvent(new Event("picker:refresh"));
                document.getElementById("productSearch").focus();
            });

            rows.addEventListener("click", e => {
                const button = e.target.closest(".remove-row");
                if (!button) return;

                if (rows.querySelectorAll("tr").length <= 1) {
                    error.textContent = "Hóa đơn phải có ít nhất một sản phẩm.";
                    return;
                }

                button.closest("tr").remove();
                error.textContent = "";
                renumber();
                calculate();
            });

            rows.addEventListener("change", e => {
                if (e.target.matches(".product-select")) {
                    error.textContent = "";
                    const row = e.target.closest("tr");
                    row.dataset.sourceId = "0";
                    row.querySelector(".quantity-input").min = "1";
                    row.querySelector(".quantity-input").step = "1";
                    renumber();
                    updateRow(row);
                }
            });

            rows.addEventListener("input", e => {
                if (e.target.matches(".quantity-input")) calculate();
            });

            form.addEventListener("submit", e => {
                renumber();
                error.textContent = "";

                const allRows = [...rows.querySelectorAll("tr")];
                const ids = allRows.map(row => row.querySelector(".product-select").value);
                if (ids.some(id => !id) || allRows.some((row, index) => ids.some((id, other) => other !== index && id === ids[index] && (!Number(row.dataset.sourceId) || !Number(allRows[other].dataset.sourceId) || row.dataset.sourceId === allRows[other].dataset.sourceId)))) {
                    e.preventDefault();
                    error.textContent = "Vui lòng chọn sản phẩm và không chọn trùng.";
                    return;
                }

                const quantitiesValid = allRows.every(row => {
                    const value = Number(row.querySelector(".quantity-input").value);
                    return validQuantity(row, value);
                });
                if (!quantitiesValid) {
                    e.preventDefault();
                    error.textContent = "Số lượng phải là số nguyên từ 1 đến 999999999.";
                    return;
                }

                if (!allRows.every(row => row.dataset.loadedProductId === row.querySelector(".product-select").value)) {
                    e.preventDefault();
                    error.textContent = "Vui lòng đợi tải xong giá bán sản phẩm.";
                }
            });

            window.ClinicSearchPicker.init(form);
            renumber();
            rows.querySelectorAll("tr").forEach(row => {
                if (row.querySelector(".product-select").value) updateRow(row);
            });
            calculate();
        })();
    </script>
}
