@model ClinicManagementSystem.Web.Models.ViewModels.Patients.PatientIndexViewModel

@{
    ViewData["Title"] = "Quản lý bệnh nhân";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý bệnh nhân</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm bệnh nhân
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Index" method="get" data-live-filter data-results-id="filter-results" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="searchTerm" value="@Model.SearchTerm"
               class="form-control"
               placeholder="Mã bệnh nhân, họ tên, số điện thoại..." />
    </div>

    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="Active" selected="@(Model.Status == "Active")">
                Đang hoạt động
            </option>
            <option value="Inactive" selected="@(Model.Status == "Inactive")">
                Ngừng hoạt động
            </option>
        </select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" data-filter-reset class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div id="filter-results" data-filter-results>
<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã bệnh nhân</th>
                <th>Họ và tên</th>
                <th>Ngày sinh</th>
                <th>Giới tính</th>
                <th>Số điện thoại</th>
                <th>Trạng thái</th>
                <th style="min-width:190px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Patients.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        Không tìm thấy bệnh nhân.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@patient.Id" class="patient-details-link">@patient.PatientCode</a></td>
                        <td><a asp-action="Details" asp-route-id="@patient.Id" class="patient-details-link">@patient.FullName</a></td>
                        <td>
                            @(patient.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")
                        </td>
                        <td>
                            @(patient.Gender switch
                            {
                                "Male" => "Nam",
                                "Female" => "Nữ",
                                "Other" => "Khác",
                                _ => "—"
                            })
                        </td>
                        <td>@(patient.PhoneNumber ?? "—")</td>
                        <td>
                            @if (patient.Status == "Active")
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng hoạt động</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Details" asp-route-id="@patient.Id"
                                   class="btn btn-sm btn-outline-info">Xem</a>

                                <a asp-action="Edit" asp-route-id="@patient.Id"
                                   class="btn btn-sm btn-outline-primary">Sửa</a>

                                <form asp-action="SetStatus" method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id"
                                           value="@patient.Id" />
                                    <input type="hidden" name="status"
                                           value="@(patient.Status == "Active" ? "Inactive" : "Active")" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary">
                                        @(patient.Status == "Active"
                                            ? "Ngừng hoạt động"
                                            : "Kích hoạt")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<p class="text-muted">Tổng số kết quả: @Model.Patients.Count</p>
</div>
