@using ClinicManagementSystem.Web.Services
@{ var detailsPaging = new ListPaging(int.TryParse(Context.Request.Query["page"], out var detailsPage) ? detailsPage : 1); var visibleDetails = detailsPaging.Slice(ListSorting.Apply(Model.Details.AsQueryable(), Context.Request.Query["sort"], d => d.Id, d => d.ProductName, d => d.Id)).ToList(); }

@model ClinicManagementSystem.Web.Models.ViewModels.Sales.SaleDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h2>Chi tiết hóa đơn</h2>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" asp-route-copyFromId="@Model.Id" class="btn btn-primary">Sao chép</a>
        <a asp-controller="Appointments" asp-action="Edit" asp-route-saleId="@Model.Id" class="btn btn-outline-primary">Lịch tái khám</a>
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Quay lại
        </a>

        @if (Model.Status == "Draft")
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                Sửa hóa đơn
            </a>
        }

        <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-dark">
            In hóa đơn
        </a>
        <a asp-action="PrintPrescription" asp-route-id="@Model.Id" class="btn btn-outline-dark">In toa thuốc</a>
        <a asp-action="PrintSelectedProducts" asp-route-id="@Model.Id" class="btn btn-outline-dark">In sản phẩm tùy chọn</a>
        @if (User.IsInRole("Admin") || (User.IsInRole("Staff") && Model.Status == "Draft"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm(this.dataset.confirm);" data-confirm="@(Model.Status == "Draft" ? "Xóa hóa đơn nháp này?" : "Xóa hóa đơn này? Hóa đơn đã xác nhận sẽ được trừ khỏi doanh thu và hoàn kho theo phiếu xuất gốc. Hóa đơn lịch sử KiotViet không hoàn kho.")">
                <button type="submit" class="btn btn-outline-danger">Xóa hóa đơn</button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success no-print">
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger no-print">
        @error
    </div>
}

<div class="card" id="invoice">
    <div class="card-body p-4">

        <div class="text-center mb-4">
            <h3 class="fw-bold">HÓA ĐƠN BÁN HÀNG</h3>
            <div class="text-muted">
                Phòng Khám Lâm Thảo
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <p class="mb-2">
                    <strong>Mã hóa đơn:</strong>
                    @Model.SaleCode
                </p>

                <p class="mb-2">
                    <strong>Ngày lập:</strong>
                    @(Model.SaleDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác nhận")
                </p>

                <p class="mb-2">
                    <strong>Trạng thái:</strong>

                    @if (Model.Status == "Confirmed")
                    {
                        <span class="badge bg-success">
                            Đã xác nhận
                        </span>
                    }
                    else if (Model.Status == "Imported") { <span class="badge bg-info text-dark">Lịch sử KiotViet</span> }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Hóa đơn nháp
                        </span>
                    }
                </p>
            </div>

            <div class="col-md-6">
                <p class="mb-2">
                    <strong>Mã bệnh nhân:</strong>
                    @Model.PatientCode
                </p>

                <p class="mb-2">
                    <strong>Họ và tên:</strong>
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
                       title="Xem chi tiết bệnh nhân">@(string.IsNullOrWhiteSpace(Model.PatientName) ? "Xem hồ sơ bệnh nhân" : Model.PatientName)</a>
                </p>
            </div>
        </div>

        <partial name="_ListSortForm" model="@(new ListSortOptions(NameLabel: "Tên hàng", HasDates: false))" />
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px">STT</th>
                        <th>Mã SP</th>
                        <th>Tên thuốc / vật tư</th>
                        <th>ĐVT</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var index = (detailsPaging.Page - 1) * ListPaging.PageSize + 1;
                    }

                    @foreach (var detail in visibleDetails)
                    {
                        <tr>
                            <td>@index</td>
                            <td>@detail.ProductCode</td>
                            <td>@detail.ProductName
                                @if (!string.IsNullOrWhiteSpace(detail.Notes))
                                {
                                    <div class="invoice-line-note">@detail.Notes</div>
                                }
                            </td>
                            <td>@detail.Unit</td>
                            <td class="text-end">
                                @detail.Quantity.ToString(detail.Quantity == decimal.Truncate(detail.Quantity) ? "N0" : "N3")
                            </td>
                            <td class="text-end">
                                @detail.UnitPrice.ToString("N0")
                            </td>
                            <td class="text-end">
                                @detail.LineTotal.ToString("N0")
                            </td>
                        </tr>

                        index++;
                    }
                </tbody>

                <tfoot>
                @if (Model.Status == "Imported" || Model.ImportedDiscount != 0 || Model.ImportedSurcharge != 0) { <tr><td colspan="6" class="text-end">Tổng tiền hàng</td><td class="text-end">@Model.ImportedGoodsTotal.ToString("N2") đ</td></tr><tr><td colspan="6" class="text-end">Giảm giá hóa đơn</td><td class="text-end">@Model.ImportedDiscount.ToString("N2") đ</td></tr><tr><td colspan="6" class="text-end">Thu khác</td><td class="text-end">@Model.ImportedSurcharge.ToString("N2") đ</td></tr> }
                    <tr class="table-light">
                        <td colspan="6"
                            class="text-end fw-bold">
                            TỔNG CỘNG
                        </td>
                        <td class="text-end fw-bold">
                            @Model.TotalAmount.ToString("N0") đ
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-3">
                <strong>Ghi chú:</strong>
                <p class="mb-0">@Model.Notes</p>
            </div>
        }

        @if (Model.Status == "Draft")
        {
            <div class="alert alert-warning mt-4">
                Đây là hóa đơn nháp. Sản phẩm chưa được xuất kho.
            </div>
        }
        else if (Model.Status == "Imported") { <div class="alert alert-info mt-4">Hóa đơn lịch sử từ KiotViet (@Model.ImportedFileName). Không trừ tồn kho hiện tại, không cộng lại tổng bán cũ.</div> }
        else if (Model.Status == "Confirmed")
        {
            <div class="alert alert-success mt-4">
                Hóa đơn đã xác nhận và ghi nhận xuất kho.
            </div>
        }
    </div>
</div>

@if (Model.Status == "Draft")
{
    <div class="mt-4 d-flex justify-content-end no-print">
        <form asp-controller="Sales"
              asp-action="Confirm"
              asp-route-id="@Model.Id"
              method="post"
              onsubmit="return confirm('Xác nhận hóa đơn này và trừ tồn kho?');">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-success btn-lg">
                Xác nhận hóa đơn &amp; Xuất kho
            </button>
        </form>
    </div>
}

<style>
    @@media print {
        @@page {
            size: A4;
            margin: 12mm;
        }

        body {
            background: white !important;
        }

        .no-print,
        header,
        footer,
        nav {
            display: none !important;
        }

        #invoice {
            border: none !important;
            box-shadow: none !important;
        }

        #invoice .card-body {
            padding: 0 !important;
        }

        #invoice .table-responsive {
            overflow: visible !important;
        }

        #invoice table {
            width: 100%;
            border-collapse: collapse;
        }

        #invoice th,
        #invoice td {
            border: 1px solid #333 !important;
            color: black !important;
        }
    }
</style>

<partial name="_ListPaging" model="detailsPaging" />
