@model ClinicManagementSystem.Web.Models.ViewModels.Inventory.StockAdjustmentViewModel
@{ ViewData["Title"] = "Kiểm kho / Cân kho"; }
<h2>Kiểm kho / Cân kho</h2>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<nav class="nav nav-tabs mb-3" aria-label="Phạm vi kiểm kho">
    <a asp-action="StockCount" class="nav-link @((bool?)ViewData["Archived"] != true ? "active" : "")">Đang kinh doanh</a>
    <a asp-action="StockCount" asp-route-archived="true" class="nav-link @((bool?)ViewData["Archived"] == true ? "active" : "")">Lưu trữ còn tồn</a>
</nav>
@if ((bool?)ViewData["Archived"] == true) { <p class="alert alert-info">Đang kiểm hàng ngừng kinh doanh còn tồn. Cân kho không kích hoạt lại sản phẩm.</p> }
<p class="text-muted">Nhập số lượng thực tế đã đếm. Để trống hàng chưa kiểm; nhập 0 khi thực tế hết hàng. Combo và dịch vụ không kiểm tồn riêng.</p>
<form asp-action="StockCount" method="get" class="mb-3"><input type="hidden" name="archived" value="@(((bool?)ViewData["Archived"] == true).ToString().ToLowerInvariant())" /><label for="count-search" class="form-label">Tìm mã hoặc tên hàng</label><div class="input-group"><input type="search" id="count-search" name="searchTerm" value="@ViewData["SearchTerm"]" class="form-control" /><button class="btn btn-outline-primary">Tìm kiếm</button></div><partial name="_ListSort" model="@(new ClinicManagementSystem.Web.Services.ListSortOptions())" /></form><p class="text-muted">Lưu số lượng đã nhập trên trang hiện tại trước khi chuyển trang hoặc tìm kiếm.</p><partial name="_ListPaging" model="@((ClinicManagementSystem.Web.Services.ListPaging?)ViewData["Paging"])" /><form asp-action="StockCount" asp-route-archived="@ViewData["Archived"]" asp-route-page="@Context.Request.Query["page"]" asp-route-sort="@Context.Request.Query["sort"]" asp-route-searchTerm="@ViewData["SearchTerm"]" method="post" id="stock-count-form">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Reason" class="form-label">Lý do kiểm kho</label><input asp-for="Reason" maxlength="500" required class="form-control" /></div>

    <div class="table-responsive"><table data-mobile-cards class="table table-bordered align-middle">
        <thead><tr><th>Mã hàng</th><th>Tên hàng</th><th>ĐVT</th><th>Tồn hệ thống</th><th>Tồn thực tế</th><th>Chênh lệch</th><th>Ghi chú</th></tr></thead>
        <tbody id="count-rows">
        @for (var i = 0; i < Model.Details.Count; i++)
        {
            <tr data-search="@Model.Details[i].ProductCode @Model.Details[i].ProductName" data-stock="@Model.Details[i].ExpectedStock.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <td>@Model.Details[i].ProductCode<input type="hidden" asp-for="Details[i].ProductId" /><input type="hidden" asp-for="Details[i].ExpectedStock" value="@Model.Details[i].ExpectedStock.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                <td>@Model.Details[i].ProductName</td><td>@Model.Details[i].Unit</td><td>@Model.Details[i].ExpectedStock.ToString("0.###")</td>
                <td><input asp-for="Details[i].CountedStock" asp-format="{0:0.############################}" type="number" min="0" max="999999999" step="1" class="form-control counted-stock" aria-label="Tồn thực tế @Model.Details[i].ProductName" /><span asp-validation-for="Details[i].CountedStock" class="text-danger"></span></td>
                <td class="difference text-end">—</td>
                <td><input asp-for="Details[i].Note" maxlength="180" class="form-control" aria-label="Ghi chú @Model.Details[i].ProductName" /></td>
            </tr>
        }
        </tbody>
    </table></div>
    <p id="count-summary" aria-live="polite" class="text-muted"></p>
    <button type="submit" class="btn btn-primary">Lưu kiểm kho và cân tồn</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const rows = [...document.querySelectorAll('#count-rows tr')];
            const formatter = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 });
            function calculate() {
                let checked = 0, changed = 0;
                rows.forEach(row => {
                    const raw = row.querySelector('.counted-stock').value;
                    const actual = Number(raw);
                    const cell = row.querySelector('.difference');
                    cell.classList.remove('text-success', 'text-danger');
                    if (!raw.trim() || !Number.isInteger(actual) || actual < 0) { cell.textContent = '—'; return; }
                    checked++;
                    const difference = actual - Number(row.dataset.stock);
                    if (difference !== 0) changed++;
                    cell.textContent = (difference > 0 ? '+' : '') + formatter.format(difference);
                    if (difference !== 0) cell.classList.add(difference > 0 ? 'text-success' : 'text-danger');
                });
                document.getElementById('count-summary').textContent = `Đã nhập ${checked} sản phẩm · ${changed} sản phẩm chênh lệch. Lưu trang hiện tại trước khi chuyển trang.`;
            }
            document.getElementById('count-rows').addEventListener('input', calculate);

            document.getElementById('stock-count-form').addEventListener('submit', e => {
                if (!window.confirm('Cân tồn kho theo các số lượng thực tế đã nhập và lưu lịch sử điều chỉnh?')) e.preventDefault();
            });
            let dirty = false;
            document.getElementById('stock-count-form').addEventListener('input', () => dirty = true);
            window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
            document.getElementById('stock-count-form').addEventListener('submit', e => { if (!e.defaultPrevented) dirty = false; });
            calculate();
        })();
    </script>
}
